{
  "unstable": ["kv", "cron"],
  "tasks": {
    "start": "deno run --unstable-kv --unstable-cron --allow-net --allow-env main.ts",
    "dev": "deno run --unstable-kv --unstable-cron --allow-net --allow-env --watch main.ts",
    "test": "deno test --unstable-kv --allow-env",
    "check": "deno check main.ts src/*.ts"
  },
  "imports": {
    "@deno/kv-oauth": "jsr:@deno/kv-oauth@^0.11.0"
  }
}
